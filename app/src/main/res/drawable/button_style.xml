<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">


    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#6A4FA8"/>
            <corners android:radius="12dp"/>
            <padding android:left="16dp" android:top="12dp"
                android:right="16dp" android:bottom="12dp"/>
            <stroke android:width="2dp" android:color="#C9B3FF"/>
        </shape>
    </item>


    <item>
        <shape android:shape="rectangle">
            <solid android:color="#7B5EC4"/>
            <corners android:radius="12dp"/>
            <padding android:left="16dp" android:top="12dp"
                android:right="16dp" android:bottom="12dp"/>
            <stroke android:width="2dp" android:color="#E1D4FF"/>
        </shape>
    </item>

</selector>
