<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">


    <item>
        <shape android:shape="rectangle">
            <solid android:color="#2C2139" /> <!-- Roxo profundo com aparência de filme antigo -->
        </shape>
    </item>


    <item android:top="3dp" android:bottom="3dp" android:left="3dp" android:right="3dp">
        <shape android:shape="rectangle">
            <solid android:color="#35204D" />
            <stroke android:width="3dp" android:color="#FFFFFF" /> <!-- Roxo polaroid -->
            <corners android:radius="6dp" />
        </shape>
    </item>

</layer-list>
