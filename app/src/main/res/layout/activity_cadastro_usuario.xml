<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="18dp"
    android:background="#1A1524"
    tools:context=".ui.usuario.CadastroUsuarioActivity">



    <TextView
        android:id="@+id/textCadastroUsuarioTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Cadastro de Usuário"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#C9A8FF"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/textCadastroUsuarioTitle"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="6dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="16dp"
                android:padding="6dp"
                android:background="#A98DE5"
            android:clipToPadding="false">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#3B235A"
            android:padding="8dp">

            <EditText
                android:id="@+id/registerNameEditText"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:hint="Nome"
                android:background="@android:color/transparent"
                android:padding="8dp"
                android:textColor="#F2E8FF"
                android:textColorHint="#BDAAE0"
                android:imeOptions="actionNext"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#33FFFFFF"
                android:alpha="0.03"/>
        </FrameLayout>
    </FrameLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginTop="12dp"
        android:padding="6dp"
        android:background="#A98DE5">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#3B235A"
            android:padding="8dp">

            <EditText
                android:id="@+id/registerEmailEditText"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:hint="Email"
                android:inputType="textEmailAddress"
                android:background="@android:color/transparent"
                android:padding="8dp"
                android:textColor="#F2E8FF"
                android:textColorHint="#BDAAE0"
                android:imeOptions="actionNext" />

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#33000000"
                android:alpha="0.03"/>
        </FrameLayout>
    </FrameLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginTop="12dp"
        android:padding="6dp"
        android:background="#A98DE5">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#3B235A"
            android:padding="8dp">

            <EditText
                android:id="@+id/registerPasswordEditText"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:hint="Senha"
                android:inputType="textPassword"
                android:background="@android:color/transparent"
                android:padding="8dp"
                android:textColor="#F2E8FF"
                android:textColorHint="#BDAAE0"
                android:imeOptions="actionNext" />

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#22000000"
                android:alpha="0.04"/>
        </FrameLayout>
    </FrameLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginTop="12dp"
        android:padding="6dp"
        android:background="#A98DE5">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#3B235A"
            android:padding="8dp">

            <EditText
                android:id="@+id/registerConfirmPasswordEditText"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:hint="Confirmar Senha"
                android:inputType="textPassword"
                android:background="@android:color/transparent"
                android:padding="8dp"
                android:textColor="#F2E8FF"
                android:textColorHint="#BDAAE0"
                android:imeOptions="actionDone" />

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#33FFFFFF"
                android:alpha="0.03"/>
        </FrameLayout>
    </FrameLayout>

    <Button
        android:id="@+id/salvarButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Cadastrar"
        android:textColor="#1A1524"
        android:backgroundTint="#C9A8FF"
        android:layout_marginTop="22dp"
        android:padding="12dp" />

    <Button
        android:id="@+id/sairButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Sair"
        android:textColor="#C9A8FF"
        android:backgroundTint="#2D2141"
        android:layout_marginTop="12dp"
        android:padding="12dp" />

</LinearLayout>
    </ScrollView>

    </androidx.constraintlayout.widget.ConstraintLayout>
